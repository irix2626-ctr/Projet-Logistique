APP_NAME="Logistique API"
APP_ENV=local
APP_KEY=
# PRODUCTION : APP_ENV=production et APP_DEBUG=false (obligatoire, voir SECURITE.md SEC-1.4)
APP_DEBUG=true
APP_URL=https://logistique-api.test
APP_TIMEZONE=UTC
APP_LOCALE=fr
APP_FALLBACK_LOCALE=fr
APP_FAKER_LOCALE=fr_FR

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=logistique
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=file
SESSION_LIFETIME=120
CACHE_STORE=file
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=local
MAIL_MAILER=log

# --- Application logistique ---
TOKEN_TTL_DAYS=30
MIN_CLIENT_VERSION=0.0.0
UPLOAD_MAX_KB=10240
UNSYNCED_AFTER_HOURS=24
# http://localhost:1420 = mode développement du client (npm run tauri dev). À retirer en production.
CORS_ALLOWED_ORIGINS=http://tauri.localhost,https://tauri.localhost,tauri://localhost,http://localhost:1420

# Compte administrateur créé par le seeder (mot de passe aléatoire affiché une seule fois)
ADMIN_IDENTIFIANT=admin
ADMIN_NOM="Administrateur"
